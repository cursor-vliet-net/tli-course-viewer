          "review": {
            "km": "draft",
            "cultural": "pending-khmer-native-review",
            "note": "Professor role: ADR docs/adr/0001-professor-mordechai-role.md (one comment type per comment; hedged cultural notes about Western customs). Type: a cultural observation, hedged (in many Western countries, often, perhaps). Khmer needs a native-speaker review."
          },
          "text": {
            "en": "Oh, how kind! Please, then thank you. In many Western countries, people often say please and thank you a lot. Perhaps even to their own family! How lovely!",
            "km": "អូ! ចិត្តល្អណាស់! please រួច thank you។ នៅប្រទេសលោកខាងលិចជាច្រើន មនុស្សតែងតែនិយាយ please និង thank you ញឹកញាប់ណាស់។ ប្រហែលជាសូម្បីតែនិយាយទៅកាន់គ្រួសាររបស់ខ្លួន! គួរឱ្យស្រឡាញ់ណាស់!"
          },
          "subtitles": {
            "en": [
              {
                "atMs": 0,
                "durationMs": 4000,
                "text": "Oh, how kind! Please, then thank you."
              },
              {
                "atMs": 4000,
                "durationMs": 4000,
                "text": "In many Western countries, people often say please and thank you a lot."
              },
              {
                "atMs": 8000,
                "durationMs": 4000,
                "text": "Perhaps even to their own family! How lovely!"
              }
            ],
            "km": [
              {
                "atMs": 0,
                "durationMs": 4000,
                "text": "អូ! ចិត្តល្អណាស់! please រួច thank you។"
              },
              {
                "atMs": 4000,
                "durationMs": 4000,
                "text": "នៅប្រទេសលោកខាងលិចជាច្រើន មនុស្សតែងតែនិយាយ please និង thank you ញឹកញាប់ណាស់។"
              },
              {
                "atMs": 8000,
                "durationMs": 4000,
                "text": "ប្រហែលជាសូម្បីតែនិយាយទៅកាន់គ្រួសាររបស់ខ្លួន! គួរឱ្យស្រឡាញ់ណាស់!"
              }
            ]
