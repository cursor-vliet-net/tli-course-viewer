      "explanations": [
        {
          "id": "s003.home-again",
          "scope": "scene",
          "leadMs": 1200,
          "windowMs": 2800,
          "durationMs": 12000,
          "review": {
            "km": "draft",
            "cultural": "pending-khmer-native-review",
            "note": "Professor role: ADR docs/adr/0001-professor-mordechai-role.md (one comment type per comment; hedged cultural notes about Western customs). Type: a cultural observation, hedged (in many Western countries, often, perhaps). Khmer needs a native-speaker review."
          },
          "text": {
            "en": "Oh, they are home again! Hello! In many Western countries, people often hug to say goodbye. Perhaps they wave too. How interesting!",
            "km": "អូ! ពួកគេត្រឡប់មកផ្ទះវិញហើយ! សួស្តី! នៅប្រទេសលោកខាងលិចជាច្រើន មនុស្សតែងតែឱបគ្នាពេលនិយាយលា។ ប្រហែលជាពួកគេគ្រវីដៃដែរ។ គួរឱ្យចាប់អារម្មណ៍ណាស់!"
          },
          "subtitles": {
            "en": [
              {
                "atMs": 0,
                "durationMs": 4000,
                "text": "Oh, they are home again! Hello!"
              },
              {
                "atMs": 4000,
                "durationMs": 4000,
                "text": "In many Western countries, people often hug to say goodbye."
              },
              {
                "atMs": 8000,
                "durationMs": 4000,
                "text": "Perhaps they wave too. How interesting!"
              }
            ],
            "km": [
              {
                "atMs": 0,
                "durationMs": 4000,
                "text": "អូ! ពួកគេត្រឡប់មកផ្ទះវិញហើយ! សួស្តី!"
              },
              {
                "atMs": 4000,
                "durationMs": 4000,
                "text": "នៅប្រទេសលោកខាងលិចជាច្រើន មនុស្សតែងតែឱបគ្នាពេលនិយាយលា។"
              },
              {
                "atMs": 8000,
                "durationMs": 4000,
                "text": "ប្រហែលជាពួកគេគ្រវីដៃដែរ។ គួរឱ្យចាប់អារម្មណ៍ណាស់!"
              }
            ]
          },
